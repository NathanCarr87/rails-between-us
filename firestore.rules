rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Game collection rules for unauthenticated multiplayer gameplay
    match /games/{gameId} {
      // Allow unauthenticated clients to read game documents
      allow read: if true;

      // Allow unauthenticated clients to create a game if gameId matches path
      allow create: if request.resource.data.gameId == gameId;

      // Allow unauthenticated clients to update a game if gameId matches path
      allow update: if request.resource.data.gameId == gameId;
    }
  }
}
