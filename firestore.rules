rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Game collection rules for unauthenticated multiplayer gameplay
    match /games/{gameId} {
      // Allow reading game documents for lobby lookup, getDoc, and real-time updates (onSnapshot)
      allow read: if true;

      // Allow creating a game document if:
      // - gameId in path matches gameId in data
      // - phase is initially 'lobby'
      allow create: if request.resource.data.gameId == gameId
                   && request.resource.data.phase == 'lobby';

      // Allow updating a game document if:
      // - gameId remains unchanged (cannot hijack/change document key)
      allow update: if request.resource.data.gameId == gameId
                   && request.resource.data.gameId == resource.data.gameId;
    }
  }
}
